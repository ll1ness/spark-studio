<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spark Studio — конфиг launch4j.

  Пути разрешаются относительно расположения самого XML (bin/):
    jar   = spark-launcher.jar   (тонкий Java-лаунчер)
    icon  = favicon.ico
    splash = spark_studio_splash17.bmp

  Иконка и сплэш встроены в репозиторий. Так как проект лежит в каталоге
  с не-ASCII путём, CLI-сборка (python bin/make_launcher.py) перед вызовом
  launch4jc копирует их в ASCII-путь (%TEMP%) и подставляет его — windres
  внутри launch4j не переваривает не-ASCII пути.

  IDE запускается в том же процессе, что и этот exe (см. SparkLauncher),
  поэтому сплэш закрывается, как только появляется окно IDE. Heap не
  ограничиваем (нет initialHeapSize/maxHeapSize), чтобы IDE хватало памяти
  по умолчанию JVM.

  Собрать: python bin/make_launcher.py  (или всё разом: python bin/make_dist.py)
-->
<launch4jConfig>
  <dontWrapJar>true</dontWrapJar>
  <headerType>gui</headerType>
  <jar>spark-launcher.jar</jar>
  <outfile>SparkStudio.exe</outfile>
  <errTitle>Spark Studio</errTitle>
  <cmdLine></cmdLine>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl></downloadUrl>
  <supportUrl>https://ll1ness.is-a.dev</supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>favicon.ico</icon>
  <jre>
    <path>%JAVA_HOME%;%PATH%</path>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>false</requires64Bit>
    <minVersion>1.8.0</minVersion>
    <maxVersion></maxVersion>
    <opt>-Dfile.encoding=UTF-8</opt>
  </jre>
  <splash>
    <file>spark_studio_splash17.bmp</file>
    <waitForWindow>true</waitForWindow>
    <timeout>60</timeout>
    <timeoutErr>true</timeoutErr>
  </splash>
  <versionInfo>
    <fileVersion>17.0.1.1</fileVersion>
    <txtFileVersion>17.0.1</txtFileVersion>
    <fileDescription>Spark Studio - visual IDE for building PHP desktop applications</fileDescription>
    <copyright>ll1ness</copyright>
    <productVersion>17.0.1.1</productVersion>
    <txtProductVersion>17.0.1</txtProductVersion>
    <productName>Spark Studio</productName>
    <companyName>Quantora</companyName>
    <internalName>SparkStudio</internalName>
    <originalFilename>SparkStudio.exe</originalFilename>
    <trademarks>Quantora, ll1ness</trademarks>
    <language>RUSSIAN</language>
  </versionInfo>
</launch4jConfig>
